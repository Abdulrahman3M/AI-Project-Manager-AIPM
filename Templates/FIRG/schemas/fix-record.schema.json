{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIRG fix record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "issue_date",
    "issue_date_known",
    "recorded_at",
    "updated_at",
    "source",
    "commits",
    "problem",
    "affected_components",
    "expected_behavior",
    "implementation_summary",
    "tests",
    "status",
    "related_fix_ids",
    "native_history_refs",
    "review_reference"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-(?:0[1-9]|[1-9][0-9]+)$"
    },
    "issue_date": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "issue_date_known": {
      "type": "boolean"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "reverted"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "person_or_team",
        "repository_or_provider",
        "issue_or_pr_reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "upstream",
            "third_party"
          ]
        },
        "person_or_team": {
          "type": "string",
          "minLength": 1
        },
        "repository_or_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue_or_pr_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "command_or_reference",
          "result",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command_or_reference": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "implementation_summary": {
      "type": "string",
      "minLength": 1
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "related_fix_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "native_history_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Citation Record",
  "type": "object",
  "required": [
    "style",
    "citations"
  ],
  "properties": {
    "style": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "citation_id",
          "source_ids",
          "location"
        ],
        "properties": {
          "citation_id": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "note_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}

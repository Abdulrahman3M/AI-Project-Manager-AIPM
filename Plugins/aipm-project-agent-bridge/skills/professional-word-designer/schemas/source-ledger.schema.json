{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Ledger",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "source_class",
          "verification_status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "journal": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_class": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "VERIFIED",
              "SUPPORTED-WITH-LIMITATION",
              "DISPUTED",
              "UNVERIFIED",
              "OUT-OF-SCOPE"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supports_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}

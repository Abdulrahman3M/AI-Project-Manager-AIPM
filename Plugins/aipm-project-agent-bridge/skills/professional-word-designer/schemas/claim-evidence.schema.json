{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim Evidence Matrix",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim",
          "importance",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "importance": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "status": {
            "enum": [
              "VERIFIED",
              "SUPPORTED-WITH-LIMITATION",
              "DISPUTED",
              "UNVERIFIED",
              "OUT-OF-SCOPE"
            ]
          },
          "supporting_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-"
            }
          },
          "contradictory_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-"
            }
          },
          "qualification": {
            "type": [
              "string",
              "null"
            ]
          },
          "citation_placement": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_status": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chapter Package Manifest",
  "type": "object",
  "required": [
    "publication_title",
    "index_file",
    "chapters"
  ],
  "properties": {
    "publication_title": {
      "type": "string"
    },
    "index_file": {
      "type": "string",
      "pattern": "\\.docx$"
    },
    "numbering_policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chapter_id",
          "order",
          "title",
          "file"
        ],
        "properties": {
          "chapter_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "\\.docx$"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimated_pages": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Plan",
  "type": "object",
  "required": [
    "research_questions",
    "inclusion_criteria",
    "exclusion_criteria",
    "stopping_criteria"
  ],
  "properties": {
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "planned_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "inclusion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_source_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freshness_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "search_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stopping_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "access_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
